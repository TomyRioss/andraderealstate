# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ruflo local runtime data
.claude-flow/

# Local agent configuration
.claude/proven-config.json
.claude/.proven-config-version

# Local previews and QA artifacts
/.next-hero-preview/
/.playwright-cli/
/dogfood-output/
/.swarm/
/tmp/

# Empty files created by local command invocations
/andrade_realstate@0.1.0
/next
/npm

# Playwright output and temporary local scripts
/.playwright-mcp/
/scratch_q2.js
